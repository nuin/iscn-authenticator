{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "iscn-email",
  "main": "worker.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "preview_urls": false,
  "send_email": [{
    "name": "EMAIL",
    "allowed_sender_addresses": ["iscn@bioinformat.org"]
  }],
  "vars": {
    "EMAIL_FROM": "iscn@bioinformat.org",
    "EMAIL_REPLY_TO": "iscn@bioinformat.org"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
