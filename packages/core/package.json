{
  "name": "@iscn/core",
  "version": "0.1.0",
  "description": "ISCN 2024 karyotype validation — parser, rule engine, and types. Pure TypeScript, zero runtime dependencies.",
  "license": "MIT",
  "author": "Paulo Nuin",
  "homepage": "https://github.com/nuin/iscn-authenticator#readme",
  "bugs": {
    "url": "https://github.com/nuin/iscn-authenticator/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data/*": "./data/*"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "data/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:browser": "node scripts/build-browser.mjs",
    "check:browser": "node scripts/build-browser.mjs --check",
    "prepublishOnly": "npm run build",
    "fetch-fixtures": "node scripts/fetch-fixtures.mjs",
    "test": "npm run fetch-fixtures && npm run test:deno && npm run test:node",
    "test:deno": "deno test --allow-read --unstable-sloppy-imports tests/*.test.ts",
    "test:node": "node --test tests/*.test.mjs"
  },
  "iscn": {
    "fixturesRepo": "nuin/iscn-authenticator-py",
    "fixturesTag": "fixtures-complex-review-20261020",
    "fixturesPath": "fixtures/validity.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuin/iscn-authenticator.git",
    "directory": "packages/core"
  },
  "keywords": [
    "iscn",
    "iscn-2024",
    "karyotype",
    "cytogenetics",
    "cytogenomics",
    "bioinformatics",
    "validation",
    "nomenclature"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
